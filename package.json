{
  "name": "r1999-timekeeper-fleet",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test:runtime": "node --import tsx --test tests/runtime/*.test.ts tests/runtime/*.test.tsx",
    "test:pipeline": "node --import tsx --test tests/pipeline/*.test.ts",
    "test:integrity": "node --import tsx --test tests/integrity/*.test.ts",
    "test": "node --import tsx --test tests/runtime/*.test.ts tests/runtime/*.test.tsx tests/pipeline/*.test.ts tests/integrity/*.test.ts && npm run typecheck",
    "build:source": "tsx scripts/extract-catalog-source.ts",
    "build:characters": "tsx scripts/build-characters.ts",
    "build:psychubes": "tsx scripts/build-psychubes.ts",
    "build:names": "tsx scripts/build-names.ts",
    "sync:gl": "tsx scripts/sync-gl-data.ts",
    "sync:cn": "tsx scripts/sync-cn-data.ts",
    "sync:names": "tsx scripts/sync-name-fallbacks.ts",
    "sync:order": "tsx scripts/sync-release-order.ts",
    "sync:uttu": "tsx scripts/sync-uttu.ts",
    "sync:uttu-names": "tsx scripts/sync-uttu-names.ts",
    "sync": "tsx scripts/sync-all.ts"
  },
  "dependencies": {
    "html2canvas-pro": "2.4.0",
    "lucide-react": "^0.469.0",
    "modern-screenshot": "^4.4.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
